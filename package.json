{
  "name": "@enclave/verify-sdk",
  "version": "0.1.0",
  "description": "Post-quantum credential cryptography for Enclave Verify",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto/*": {
      "types": "./dist/crypto/*.d.ts",
      "import": "./dist/crypto/*.js"
    },
    "./credential/*": {
      "types": "./dist/credential/*.d.ts",
      "import": "./dist/credential/*.js"
    },
    "./verify/*": {
      "types": "./dist/verify/*.d.ts",
      "import": "./dist/verify/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx scripts/keygen.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Enclave-Verify/enclave-verify-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
